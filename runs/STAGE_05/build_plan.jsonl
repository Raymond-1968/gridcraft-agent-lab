{"step": 8, "command": "range.setValues", "params": {"range": "A12", "values": [["1. За каждый месяц с начала учёта возникает обязательство (по умолчанию из B5, исключения — ниже)."], ["2. Месяц входит в накопленное обязательство, когда «Расчёт на дату» позже этого месяца (оплата за прошлый месяц)."], ["3. Все поступления A и B с датой от начала учёта до «Расчёт на дату» вычитаются из накопленного обязательства."], ["4. Месяц оплаты не указывается; переплата уменьшает общий остаток."], ["5. Ожидается от B = накопленное обязательство − поступления A."]]}}
{"step": 9, "command": "selection.set", "params": {"range": "B4"}}
{"step": 10, "command": "sheet.activate", "params": {"sheet": "Учёт"}}
{"step": 11, "command": "home.numberFormat", "params": {"range": "B4", "format": "Text"}}
{"step": 12, "command": "home.numberFormat", "params": {"range": "A14:A513", "format": "Text"}}
{"step": 13, "command": "range.setValues", "params": {"range": "A1", "values": [["Учёт поступлений: общий баланс"], ["Вымышленные данные, EUR. Жёлтое — ввод. Правила и сумма обязательства — на листе «Настройки»."]]}}
{"step": 14, "command": "range.setValues", "params": {"range": "A4", "values": [["Расчёт на дату (дд.мм.гггг)", "15.11.2026", "=IF(ISNUMBER(H4),\"\",\"Ошибка: введите дату как дд.мм.гггг\")"], ["Месяцев к оплате", "=IF(AND(ISNUMBER(H5),ISNUMBER(H6)),MAX(0,(YEAR(H5)-YEAR(H6))*12+MONTH(H5)-MONTH(H6)+1),0)", "=IF(B5>0,\"с \"&TEXT(H6,\"mm.yyyy\")&\" по \"&TEXT(H5,\"mm.yyyy\"),\"нет месяцев к оплате\")"], ["Накопленное обязательство", "=IF(B5=0,0,B5*H7+SUMIFS('Настройки'!$B$19:$B$42,'Настройки'!$C$19:$C$42,\">=\"&H6,'Настройки'!$C$19:$C$42,\"<=\"&H5,'Настройки'!$B$19:$B$42,\"<>\")-H7*COUNTIFS('Настройки'!$C$19:$C$42,\">=\"&H6,'Настройки'!$C$19:$C$42,\"<=\"&H5,'Настройки'!$B$19:$B$42,\"<>\"))", null], ["Получено от A", "=SUMIFS($C$14:$C$513,$B$14:$B$513,'Настройки'!$A$8,$I$14:$I$513,\"учтено\")", null], ["Получено от B", "=SUMIFS($C$14:$C$513,$B$14:$B$513,'Настройки'!$A$9,$I$14:$I$513,\"учтено\")", null], ["Остаток к получению", "=MAX(0,B6-B7-B8)", null], ["Переплата", "=MAX(0,B7+B8-B6)", null]]}}
{"step": 15, "command": "range.setValues", "params": {"range": "D4", "values": [["Ожидается от B всего (обязательство − A)", "=MAX(0,B6-B7)"], ["Не учтено: дата позже даты расчёта, EUR", "=SUMIFS($C$14:$C$513,$I$14:$I$513,\"Не учтено: дата позже*\")"], ["Строк с ошибками", "=COUNTIF($I$14:$I$513,\"Ошибка*\")"], ["=IF(E6>0,\"Есть ошибки — см. колонку «Проверка»\",\"\")", null]]}}
{"step": 16, "command": "range.setValues", "params": {"range": "A11", "values": [["Новая запись — в первую пустую строку: дата (Ctrl+; — сегодня, или дд.мм.гггг), плательщик A/B, сумма, примечание по желанию."]]}}
{"step": 17, "command": "range.setValues", "params": {"range": "A13", "values": [["Дата получения", "Плательщик", "Сумма, EUR", "Примечание", "Проверка"]]}}
{"step": 18, "command": "range.setValues", "params": {"range": "A14", "values": [["05.10.2026", "A", 600, null], ["12.10.2026", "B", 300, "частичный платёж"], ["20.10.2026", "B", 150, null], ["03.11.2026", "A", 700, null], ["10.11.2026", "B", 420, null], ["16.11.2026", "B", 50, "контрольный пример: позже даты расчёта"]]}}
{"step": 19, "command": "range.setValues", "params": {"range": "H3", "values": [["служебные"], ["=IF(B4=\"\",\"\",IFERROR(IF(ISNUMBER(B4),B4,LET(t,TRIM(B4),sl,ISNUMBER(FIND(\"/\",t)),iso,MID(t,5,1)=\"-\",pa,IFERROR(FIND(\"/\",t),0),pb,IFERROR(FIND(\"/\",t,pa+1),0),dd,IF(sl,IFERROR(VALUE(MID(t,pa+1,pb-pa-1)),0),IF(iso,IFERROR(VALUE(MID(t,9,2)),0),IFERROR(VALUE(LEFT(t,2)),0))),mm,IF(sl,IFERROR(VALUE(LEFT(t,pa-1)),0),IF(iso,IFERROR(VALUE(MID(t,6,2)),0),IFERROR(VALUE(MID(t,4,2)),0))),yy,IF(sl,IFERROR(VALUE(MID(t,pb+1,4)),0),IF(iso,IFERROR(VALUE(LEFT(t,4)),0),IFERROR(VALUE(MID(t,7,4)),0))),ok,IF(sl,AND(pb>0,LEN(t)-pb=4),AND(LEN(t)=10,OR(iso,AND(MID(t,3,1)=\".\",MID(t,6,1)=\".\")))),dt,IFERROR(DATE(yy,mm,dd),0),IF(AND(ok,dd>=1,mm>=1,mm<=12,DAY(dt)=dd,MONTH(dt)=mm),dt,\"ошибка\"))),\"ошибка\"))"], ["=IF(ISNUMBER(H4),EDATE(DATE(YEAR(H4),MONTH(H4),1),-1),\"\")"], ["='Настройки'!C4"], ["='Настройки'!B5"]]}}
{"step": 20, "command": "selection.set", "params": {"range": "H14:H513", "active": "H14"}}
{"step": 21, "command": "range.fill", "params": {"range": "H14:H513", "input": "=IF(A14=\"\",\"\",IFERROR(IF(ISNUMBER(A14),A14,LET(t,TRIM(A14),sl,ISNUMBER(FIND(\"/\",t)),iso,MID(t,5,1)=\"-\",pa,IFERROR(FIND(\"/\",t),0),pb,IFERROR(FIND(\"/\",t,pa+1),0),dd,IF(sl,IFERROR(VALUE(MID(t,pa+1,pb-pa-1)),0),IF(iso,IFERROR(VALUE(MID(t,9,2)),0),IFERROR(VALUE(LEFT(t,2)),0))),mm,IF(sl,IFERROR(VALUE(LEFT(t,pa-1)),0),IF(iso,IFERROR(VALUE(MID(t,6,2)),0),IFERROR(VALUE(MID(t,4,2)),0))),yy,IF(sl,IFERROR(VALUE(MID(t,pb+1,4)),0),IF(iso,IFERROR(VALUE(LEFT(t,4)),0),IFERROR(VALUE(MID(t,7,4)),0))),ok,IF(sl,AND(pb>0,LEN(t)-pb=4),AND(LEN(t)=10,OR(iso,AND(MID(t,3,1)=\".\",MID(t,6,1)=\".\")))),dt,IFERROR(DATE(yy,mm,dd),0),IF(AND(ok,dd>=1,mm>=1,mm<=12,DAY(dt)=dd,MONTH(dt)=mm),dt,\"ошибка\"))),\"ошибка\"))"}}
